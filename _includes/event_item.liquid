{% assign months = "Jan.,Feb.,March,April,May,June,July,Aug.,Sept.,Oct.,Nov.,Dec." | split: "," %}
{% assign s = include.e.date %}
{% assign t = include.e.end_date | default: s %}
{% assign sm = s | date: "%-m" | minus: 1 %}{% assign tm = t | date: "%-m" | minus: 1 %}
{% assign sd = s | date: "%-d" %}{% assign td = t | date: "%-d" %}
{% assign sy = s | date: "%Y" %}{% assign ty = t | date: "%Y" %}
{% if sy != ty %}
  {% capture when %}{{ months[sm] }} {{ sd }}, {{ sy }} - {{ months[tm] }} {{ td }}, {{ ty }}{% endcapture %}
{% elsif sm != tm %}
  {% capture when %}{{ months[sm] }} {{ sd }} - {{ months[tm] }} {{ td }}, {{ ty }}{% endcapture %}
{% elsif sd != td %}
  {% capture when %}{{ months[sm] }} {{ sd }} - {{ td }}, {{ ty }}{% endcapture %}
{% else %}
  {% capture when %}{{ months[sm] }} {{ sd }}, {{ sy }}{% endcapture %}
{% endif %}
{% assign sl = include.e.slides %}{% unless sl contains "://" %}{% assign sl = "/assets/pdf/" | append: sl | relative_url %}{% endunless %}
{% assign nt = include.e.notes %}{% unless nt contains "://" %}{% assign nt = "/assets/pdf/" | append: nt | relative_url %}{% endunless %}
<li>{% if include.e.link %}<a href="{{ include.e.link }}">{{ include.e.title }}</a>{% else %}{{ include.e.title }}{% endif %}{% if include.e.role %} ({{ include.e.role }}){% endif %}{% if include.e.place %}, {{ include.e.place }}{% endif %}, {{ when | strip }}{% if include.e.slides %}, <a href="{{ sl }}">slides</a>{% endif %}{% if include.e.notes %}, <a href="{{ nt }}">notes</a>{% endif %}</li>
